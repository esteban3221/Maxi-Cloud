datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id        String   @id @default(uuid())
  uuid      String   @unique
  name      String
  apiKey    String   @unique @map("api_key")
  active    Boolean  @default(true)
  logs      Log[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("devices")
}

model Log {
  id          String   @id @default(uuid())
  uuidCloud   String   @unique @map("uuid_cloud")
  localId     Int      @map("local_id")
  idUserLocal Int      @map("id_user_local")
  tipo        String
  descripcion String
  ingreso     Float
  cambio      Float
  total       Float
  estatus     String
  fecha       DateTime

  deviceId String @map("device_id")
  device   Device @relation(fields: [deviceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("logs")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String? // Signo ? para que sea opcional si inician con Google
  googleId  String?  @unique // <--- Agregar este campo
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UpdateRelease {
  id        Int      @id @default(autoincrement())
  channel   String // "lts" o "testing"
  platform  String // "windows" o "linux-arm" (nuevo)
  major     Int
  minor     Int
  patch     Int
  build     Int
  url       String
  createdAt DateTime @default(now())
}
